@page "/addproduct"
@rendermode InteractiveServer
@using Labb2_Blazor.Dto;
@using Labb2_Shared.Interfaces
@inject IProductService _productService

@if(_IsAuthorized){
<PageTitle>Add Product</PageTitle>
<h3>Add Product</h3>

<EditForm Model="Product"
	OnInvalidSubmit="@InvalidInput"
OnValidSubmit="@ValidInput">


	<div class="Row mb-3">
		@if (!string.IsNullOrEmpty(message))
		{
			<div class="@statusClass" role="alert">
				@message
			</div>
		}

		<div class="col-md-8">
		<label for="name" class="col-form-label col-md-3" >Product Name</label>
			<InputText id="productName" class="form-control col-md-3" @bind-Value="@Product.Name" placeholder="Enter Product name"></InputText>
		</div>

		<div>
		<label for="name" class="col-form-label col-md-3">Product Description</label>
			<InputText id="productDescription" class="form-control col-md-3" @bind-Value="@Product.Description" placeholder="Enter short description"></InputText>
		</div>

	<div class="row mb-3">
		<label for="category" class="col-form-label col-md-3">Product category:</label>
		<div class="col-md-3">
			<InputSelect id="ProductCategories" class="form-control col-md-3" @bind-Value="@Product.CategoryId" placeholder="Enter product category">
				@foreach (var category in Categories)
				{
					<option value="@category.Id">@category.Name</option>
				}
			</InputSelect>
	</div>
		<div class="row mb-3">
			<label for="category" class="col-form-label col-md-3">Product price:</label>
			<div class="col-md-8">
				<InputNumber id="productPrice" class="form-control col-md-8" min="0" @bind-Value="@Product.Price"></InputNumber>
			</div>
			<ValidationMessage class="offset-md-3" For="@(() => Product.Price)" />
		</div>
			<div class="row mb-3">
				<label for="price" class="col-form-label col-md-3">Product in stock:</label>
				<div class="col-md-8">
					<InputCheckbox id="productStatus" @bind-Value="@Product.Status"></InputCheckbox><span class="ms-2">If in stock checked</span>
				</div>
			</div>

			<div>
				<button type="submit" class="btn btn-outline-primary ms-1">Submit</button>
			</div>

		</div>
	</div>
</EditForm>
}
else{
		<p>I don't know how you got here, but you shouldn't see this.</p>

}
@if(!isProductSaved)
{


}

