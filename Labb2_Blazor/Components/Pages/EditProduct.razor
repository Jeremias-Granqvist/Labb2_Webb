@page "/EditProduct"
@rendermode InteractiveServer

<h3>EditProduct</h3>

<div>
	<input type="text" @bind="searchQuery" placeholder="Search by product name" class="form-control" />
	<button class="btn btn-primary mt-2" @onclick="SearchProducts">Search</button>
</div>

@if (filteredProducts.Any())
{
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>Category</th>
				<th>Product name</th>
				<th>Price</th>
                <th>Edit</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var product in filteredProducts)
			{
				<tr>
					<td>@GetCategoryName(product.CategoryId)</td>
					<td>@product.Name</td>
					<td>@product.Price</td>
                    <td><button class="btn btn-secondary btn-sm" @onclick="() => OnEditClick(product)">Edit</button></td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p> No products Found</p>
}

@if (isEditing)
{
    <div class="mt-3">
        <h4>Edit Product</h4>
        <EditForm Model="productToEdit" OnValidSubmit="UpdateProduct">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="category">Category</label>
                <select class="form-control" id="category" @bind="productToEdit.CategoryId">
                    @foreach (var category in allCategories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label for="name">Product Name</label>
                <input type="text" id="name" class="form-control" @bind="productToEdit.Name" />
            </div>

            <div class="form-group">
                <label for="price">Price</label>
                <input type="number" id="price" class="form-control" @bind="productToEdit.Price" />
            </div>

            <div class="form-group">
                <label for="description">Product description</label>
                <input type="text" id="description" class="form-control" @bind="productToEdit.Description" />
            </div>

            <div class="form-group">
                <label>
                    <InputCheckbox @bind-Value="productToEdit.Status" />
                    In Stock
                </label>
            </div>

            <button type="submit" class="btn btn-success mt-2">Save Changes</button>
            <button type="button" class="btn btn-secondary mt-2" @onclick="CancelEdit">Cancel</button>
            <button type="button" class="btn btn-secondary mt-2" @onclick="DeleteProduct">Delete Product</button>

        </EditForm>
    </div>
}