@page "/allcustomers"
@rendermode InteractiveServer
@using Labb2_Shared.Interfaces
@inject ICustomerService _customerService
@inject IAdressService _adressService
@inject IOrderService _orderService
@inject IOrderitemService _orderItemService
@inject IProductService _productService
@inject AuthenticationStateProvider AuthenticationStateProvider


<AuthorizeView Roles="Admin" Context="authContext">
    <Authorized>
<h3>AllCustomers</h3>
<div>
	<input type="text" @bind="searchQuery" placeholder="Search by customer email" class="form-control" />
	<button class="btn btn-primary mt-2" @onclick="SearchCustomers">Search</button>
</div>

@if (filteredCustomers.Any())
{
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>CustomerId</th>
				<th>First name</th>
				<th>Last name</th>
                <th>Email</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var customer in filteredCustomers)
			{
				<tr>
					<td>@customer.UserId</td>
					<td>@customer.Firstname</td>
					<td>@customer.Lastname</td>
                    <td>@customer.Email</td>
					<td><button class="btn btn-secondary btn-sm" @onclick="() => OnEditClick(customer)">Edit</button></td>

				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p> No Customers Found</p>
}

@if (isEditing)
{
    <div class="mt-3">
        <h4>Edit Product</h4>
        <EditForm OnValidSubmit="UpdateCustomer" EditContext="@editContext">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group" >
                <label for="name">Firstname</label>
                <input type="text" id="Firstname" class="form-control" @bind="CustomerToEdit.Firstname" />
            </div>

            <div class="form-group">
                <label for="price">Lastname</label>
                <input type="text" id="Lastname" class="form-control" @bind="CustomerToEdit.Lastname" />
            </div>

            <div class="form-group">
                <label for="description">Email</label>
                <input type="text" id="Email" class="form-control" @bind="CustomerToEdit.Email" />
            </div>
            
