@page "/allcustomers"
@rendermode InteractiveServer

<h3>AllCustomers</h3>
<div>
	<input type="text" @bind="searchQuery" placeholder="Search by customer name" class="form-control" />
	<button class="btn btn-primary mt-2" @onclick="SearchCustomers">Search</button>
</div>

@if (filteredCustomers.Any())
{
	<table class="table table-striped mt-3">
		<thead>
			<tr>
				<th>CustomerId</th>
				<th>First name</th>
				<th>Last name</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var customer in filteredCustomers)
			{
				<tr>
					<td>@customer.CustomerId</td>
					<td>@customer.Firstname</td>
					<td>@customer.Lastname</td>
					<td><button class="btn btn-secondary btn-sm" @onclick="() => OnEditClick(customer)">Edit</button></td>

				</tr>
			}
		</tbody>
	</table>
}
else
{
	<p> No Customers Found</p>
}

@if (isEditing)
{
    <div class="mt-3">
        <h4>Edit Product</h4>
        <EditForm Model="CustomerToEdit" OnValidSubmit="UpdateCustomer">
            <DataAnnotationsValidator />
            <ValidationSummary />



            <div class="form-group">
                <label for="name">Firstname</label>
                <input type="text" id="Firstname" class="form-control" @bind="CustomerToEdit.Firstname" />
            </div>

            <div class="form-group">
                <label for="price">Lastname</label>
                <input type="text" id="Lastname" class="form-control" @bind="CustomerToEdit.Lastname" />
            </div>

            <div class="form-group">
                <label for="description">Email</label>
                <input type="text" id="Email" class="form-control" @bind="CustomerToEdit.Email" />
            </div>
            
            <div class="form-group">
                <label for="description">Street</label>
                <input type="text" id="Adress" class="form-control" @bind="CustomerToEdit.Adress.StreetName" />
            </div>
            <div class="form-group">
                <label for="description">Zipcode</label>
                <input type="text" id="Adress" class="form-control" @bind="CustomerToEdit.Adress.ZipCode" />
            </div>
            <div class="form-group">
                <label for="description">Country</label>
                <input type="text" id="Adress" class="form-control" @bind="CustomerToEdit.Adress.ZipCode" />
            </div>
            
            @if (CustomerToEdit.Orders != null && CustomerToEdit.Orders.Count != 0)
            {
            <div class="form-group">
                <label for="Orders">Orders</label>
                <select class="form-control" id="orders" @bind="CustomerToEdit.Orders">
                    @foreach (var order in CustomerToEdit.Orders)
                    {
                        <option value="@CustomerToEdit.Orders">@CustomerToEdit.Orders</option>
                    }
                </select>
            </div>
            }

            <button type="submit" class="btn btn-success mt-2">Save Changes</button>
            <button type="button" class="btn btn-secondary mt-2" @onclick="CancelEdit">Cancel</button>

        </EditForm>
    </div>
}

