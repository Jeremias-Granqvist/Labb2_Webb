@page "/UserPage"
@rendermode InteractiveServer

@using Labb2_Shared.Interfaces;
@using Blazored.LocalStorage;
@inject ILocalStorageService localStorage
@inject ICustomerService customerService
@inject IAdressService adressService
@inject IAccountService accountService
@inject IOrderService orderService
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider customAuthStateProvider
<h3>UserPage</h3>

@if (user == null)
{
    <p>Loading...</p>
}
else
{
    <div>
        <h4>User Information</h4>
        <p><strong>FirstName:</strong> <input type="text" @bind="@user.Firstname" /></p>
        <p><strong>LastName:</strong> <input type="text" @bind="@user.Lastname" /></p>
        <p><strong>Email:</strong> <input type="email" @bind="@user.Email" /></p>
        <p><strong>Phone Number:</strong> <input type="tel" @bind="@user.PhoneNo" /></p>
        
        <h4>Address Information</h4>
        <p><strong>Street:</strong> <input type="text" @bind="@user.Adress.StreetName" /></p>
        <p><strong>City:</strong> <input type="text" @bind="@user.Adress.City" /></p>
        <p><strong>Zipcode:</strong> <input type="text" @bind="@user.Adress.ZipCode" /></p>
        <p><strong>Country:</strong> <input type="text" @bind="@user.Adress.Country" /></p>

        <button class ="btn btn-primary mt-2" @onclick ="UpdateCustomer" id="updateButton">Update Information</button>
        <h4>Orders</h4>
        @if (orders != null && orders.Any())
        {
            <ul>
                @foreach (var order in orders)
                {
                    <li>Order ID: @order.OrderId, Date: @order.DateOfOrder, Total: @order.DateOfOrder</li>
                }
            </ul>
        }
        else
        {
            <p>No orders found.</p>
        }
    </div>
}
